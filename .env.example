# ==============================================================================
# Multi-Repo Integration Test Platform - Local Environment Configuration
# Copy this file to .env and adjust paths/tags according to your local setup.
# ==============================================================================

# Local Repository Paths (point to your local checkout directories)
SORT_MISTAKE_DIR=${HOME}/path/to/sort-mistake
SORT_SERVICE_DIR=${HOME}/path/to/sort-service

# Local Container Image Tags (defaults to <service>:latest if unset)
SORT_MISTAKE_IMAGE=sort-mistake:local
SORT_SERVICE_IMAGE=sort-service:local

# Canonical Protobuf Schema Paths (fail-fast: dev must have repos checked out)
# Format: point to exact .proto in canonical repos
SORT_NODE_PROTO=${HOME}/path/to/sort-protos/src/main/protobuf/sortmistake/sort_node.proto
